// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  otp             String?
  otpExpiresAt    DateTime?
  otpAttempts     Int       @default(0)
  sessionToken    String?
  preferredLocale String?
  pendingCuisine        String?
  pendingRestaurantName String?
  pendingCurrency       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  supportMessages SupportMessage[]
  sessions        Session[]
  restaurantUsers RestaurantUser[]

  @@map("users")
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum Plan {
  FREE
  BASIC
  PRO
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  INACTIVE
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

model Restaurant {
  id              String   @id @default(cuid())
  title           String
  subtitle        String?
  description     String?
  slug            String?
  currency        String   @default("EUR")
  source          String?
  backgroundType  String?
  accentColor     String   @default("#ED3A3A")
  address         String?
  x               String?
  y               String?
  googlePlaceId   String?
  phone           String?
  instagram       String?
  whatsapp        String?
  languages       String[] @default(["en"])
  defaultLanguage String   @default("en")
  hideTitle       Boolean  @default(false)
  menuLayout      String   @default("flat")
  paymentMethods  String[] @default(["cash", "card"])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  checklistMenuEdited      Boolean @default(false)
  checklistContactsSaved   Boolean @default(false)
  checklistBrandCustomized Boolean @default(false)
  startedFromScratch       Boolean @default(false)
  fromScanner              Boolean @default(false)
  scanBannerDismissed      Boolean @default(false)

  freeTranslationsLeft      Int @default(5)
  freeImageGenerationsLeft  Int @default(2)
  translationsUsed      Int @default(0)
  imageGenerationsUsed  Int @default(0)
  imageStylizationsUsed Int @default(0)

  reservationsEnabled    Boolean @default(false)
  reservationMode        String  @default("manual")
  reservationSlotMinutes Int     @default(90)
  workingHoursStart      String  @default("10:00")
  workingHoursEnd        String  @default("22:00")
  reservationSchedule    Json?
  timezone               String  @default("UTC")
  ordersEnabled          Boolean @default(false)
  orderNameEnabled       Boolean @default(true)
  orderPhoneEnabled      Boolean @default(false)
  orderAddressEnabled    Boolean @default(false)
  orderMode              String  @default("internal")

  // Per-restaurant billing (2026-05-28). Trial set only on the user's first
  // restaurant; subsequent restaurants start FREE without trial.
  plan                  Plan?
  billingCycle          BillingCycle?
  subscriptionStatus    SubscriptionStatus  @default(INACTIVE)
  currentPeriodEnd      DateTime?
  paymentProcessing     Boolean             @default(false)
  stripeSubscriptionId  String?             @unique
  trialEndsAt           DateTime?

  tables          Table[]
  reservations    Reservation[]
  orders          Order[]
  categories      Category[]
  items           Item[]
  pageViews       PageView[]
  restaurantUsers RestaurantUser[]
  supportMessages SupportMessage[]

  @@index([slug])
  @@map("restaurants")
}

model RestaurantUser {
  id           String   @id @default(cuid())
  restaurantId String
  userId       String
  addedAt      DateTime @default(now())
  addedBy      String?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, userId])
  @@index([userId])
  @@index([restaurantId])
  @@map("restaurant_users")
}

model Table {
  id           String   @id @default(cuid())
  restaurantId String
  number       Int
  capacity     Int
  zone         String?
  description  String?
  translations Json?
  imageUrl     String?
  color        String?
  x            Float?
  y            Float?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  isExample    Boolean  @default(false)
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@index([restaurantId])
  @@index([restaurantId, isActive])
  @@map("tables")
}

model Reservation {
  id           String   @id @default(cuid())
  restaurantId String
  tableId      String
  date         DateTime @db.Date
  startTime    String
  duration     Int
  guestName    String
  guestEmail   String
  guestPhone   String?
  guestsCount  Int
  status       String   @default("pending")
  notes        String?
  isExample    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table      Table      @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([restaurantId, date])
  @@index([restaurantId, status])
  @@index([tableId, date])
  @@map("reservations")
}

model Category {
  id           String     @id @default(cuid())
  name         String
  translations Json?
  sortOrder    Int        @default(0)
  isActive     Boolean    @default(true)
  isGroup      Boolean    @default(false)
  parentId     String?
  parent       Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[] @relation("CategoryTree")
  deletedAt    DateTime?
  restaurantId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      Item[]

  @@index([restaurantId])
  @@index([restaurantId, sortOrder])
  @@index([restaurantId, deletedAt])
  @@map("categories")
}

model Item {
  id           String   @id @default(cuid())
  name         String
  description  String?
  translations Json?
  price        Decimal  @db.Decimal(10, 2)
  imageUrl     String?
  allergens    String[] @default([])
  diets        String[] @default([])
  options      Json?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  isExample    Boolean  @default(false)
  deletedAt    DateTime?
  categoryId   String?
  restaurantId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category   Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([categoryId, sortOrder])
  @@index([restaurantId])
  @@index([restaurantId, categoryId])
  @@map("items")
}

model PageView {
  id           String   @id @default(cuid())
  restaurantId String
  sessionId    String
  page         String
  language     String
  referrer     String?
  userAgent    String?
  ip           String?
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([restaurantId, createdAt])
  @@map("page_views")
}

model SupportMessage {
  id           String   @id @default(cuid())
  restaurantId String
  userId       String
  message      String   @db.Text
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
  @@map("support_messages")
}

model UsageEvent {
  id           String   @id @default(cuid())
  at           DateTime @default(now())
  event        String
  country      String   @default("XX")
  region       String   @default("")
  device       String?
  platform     String?
  gclid        String?
  ad_params    String?
  userId       String?
  restaurantId String?
  ip           String?
  is_google_ads   Boolean  @default(false)
  is_facebook_ads Boolean  @default(false)
  is_search       Boolean  @default(false)
  fbSentEvents    String[] @default([])

  @@index([at])
  @@index([event, at])
  @@index([gclid])
  @@map("usage_events")
}

model Order {
  id              String   @id @default(cuid())
  restaurantId    String
  items           Json
  total           Decimal  @db.Decimal(10, 2)
  currency        String   @default("EUR")
  customerName    String?
  customerPhone   String?
  customerAddress String?
  comment         String?
  tableNumber     Int?
  status          String   @default("new")
  statusBeforeClose String?
  paymentMethodId String?
  isExample       Boolean  @default(false)
  deletedAt       DateTime?
  orderDate       DateTime @db.Date
  dailyNumber     Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, orderDate, dailyNumber])
  @@index([restaurantId, createdAt])
  @@map("orders")
}
